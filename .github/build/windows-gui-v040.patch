+#ifndef QBITX_WINDOWSTYLE_H
+#define QBITX_WINDOWSTYLE_H
+
+#include <QWindow>
+#if defined(Q_OS_WIN)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <QLibrary>
+#endif
+
+// Keep native resize, snapping and caption buttons; only change frame colors.
+inline bool applyWalletWindowStyle(QWindow *window)
+{
+#if defined(Q_OS_WIN)
+    if (!window) return false;
+    static QLibrary dwm(QStringLiteral("dwmapi"));
+    using SetAttribute = HRESULT (WINAPI *)(HWND, DWORD, LPCVOID, DWORD);
+    auto setAttribute = reinterpret_cast<SetAttribute>(dwm.resolve("DwmSetWindowAttribute"));
+    if (!setAttribute) return false;
+    const HWND handle = reinterpret_cast<HWND>(window->winId());
+    const BOOL dark = TRUE;
+    // Numeric DWM attributes also compile with older MinGW SDK headers.
+    const HRESULT result = setAttribute(handle, 20, &dark, sizeof(dark));
+    const COLORREF caption = RGB(11, 19, 34);
+    const COLORREF text = RGB(237, 243, 255);
+    const COLORREF noBorder = 0xfffffffe;
+    setAttribute(handle, 35, &caption, sizeof(caption));
+    setAttribute(handle, 36, &text, sizeof(text));
+    setAttribute(handle, 34, &noBorder, sizeof(noBorder));
+    return SUCCEEDED(result);
+#else
+    Q_UNUSED(window);
+    return false;
+#endif
+}
+
+#endif
